# Copy to .env and change the values. .env is git-ignored.
# Every variable has a development-only default in docker-compose.yml.

POSTGRES_PASSWORD=postgres

# Shared by every service that validates tokens. At least 32 characters.
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
JWT_EXPIRATION=1h

# First admin created by auth-service on startup
ADMIN_EMAIL=admin@ticketflow.local
ADMIN_PASSWORD=Admin12345
